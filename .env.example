# Never commit real values.

# --- Akahu -----------------------------------------------------------------
# App credentials, from the Akahu developer console. These identify and
# authenticate Next Wealth itself. Server-side only — they are read in
# lib/akahu/api.ts and never reach the browser or a mobile bundle. Shipping
# either to a client is an automatic Tier 2 accreditation failure.
AKAHU_APP_TOKEN=
AKAHU_APP_SECRET=

# Where Akahu returns the user after they grant consent. Must exactly match the
# redirect URI registered on the Akahu app. Defaults to the Vercel production
# URL, or http://localhost:3000 in development.
AKAHU_REDIRECT_ORIGIN=

# Key for encrypting each user's Akahu access token at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# Losing or rotating this key invalidates every stored connection — users have
# to reconnect their banks.
AKAHU_TOKEN_KEY=

# --- Supabase --------------------------------------------------------------
# Public values: the session that guards every private route, and the database
# the sync writes to.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (service role). Bypasses row-level security, so it is server-side
# only and must never be given a NEXT_PUBLIC_ prefix. It exists because
# akahu_tokens and akahu_oauth_state have RLS on with no policy — unreachable
# with the publishable key by design — and because deleting a user requires it.
SUPABASE_SECRET_KEY=
