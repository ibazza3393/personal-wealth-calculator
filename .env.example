# Akahu OAuth app. Each user connects their own banks, so there is no single
# user token any more: AKAHU_USER_TOKEN is gone. Register an app and set its
# Redirect URI to  https://<your-domain>/api/akahu/callback
AKAHU_APP_TOKEN=
AKAHU_APP_SECRET=

# Encrypts each user's access token before it is stored. 32 bytes, base64:
#   openssl rand -base64 32
# Rotating this makes every stored token unreadable and forces a reconnect.
AKAHU_TOKEN_KEY=

# Server-only Supabase key. Reads the akahu_tokens table, which has RLS on
# and no policies so nothing else can. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# Supabase Auth (Google) — also the database the sync writes to, and the
# session that guards every private route. Values live in .env.local / Vercel
# env, never in the repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
