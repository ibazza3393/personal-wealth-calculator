# Required in production so /api/akahu cannot leak balances on a public Vercel URL.
WEALTH_PERSONAL_KEY=

# Supabase Auth (Google). Values live in .env.local / Vercel env — never commit them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
